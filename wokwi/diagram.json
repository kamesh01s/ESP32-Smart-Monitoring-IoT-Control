#include <DHT.h>

#define DHT_PIN 4
#define DHT_TYPE DHT11

#define LED_PIN 2

DHT dht(DHT_PIN, DHT_TYPE);

void setup() {
    Serial.begin(115200);

    pinMode(LED_PIN, OUTPUT);

    dht.begin();

    Serial.println("================================");
    Serial.println("ESP32 Smart Monitoring System");
    Serial.println("================================");
}

